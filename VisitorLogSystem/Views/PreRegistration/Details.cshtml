@model VisitorLogSystem.ViewModels.PreRegistrationViewModel

@{
    ViewData["Title"] = "Pre-Registration Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Visitor Information</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Full Name:</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Purpose:</dt>
                        <dd class="col-sm-8">@(Model.Purpose ?? "N/A")</dd>

                        <dt class="col-sm-4">Expected Visit Date:</dt>
                        <dd class="col-sm-8">@Model.ExpectedVisitDate.ToString("MMM dd, yyyy hh:mm tt")</dd>

                        <dt class="col-sm-4">Host:</dt>
                        <dd class="col-sm-8">@(Model.HostUserName ?? "Not Assigned")</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsCheckedIn)
                            {
                                <span class="badge bg-success">Checked In</span>
                            }
                            else if (Model.ExpectedVisitDate < DateTime.Now)
                            {
                                <span class="badge bg-warning">Overdue</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Pending</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created At:</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</dd>

                        @if (Model.IsCheckedIn)
                        {
                            <dt class="col-sm-4">Checked In By:</dt>
                            <dd class="col-sm-8">@(Model.CheckedInByUserName ?? "N/A")</dd>

                            <dt class="col-sm-4">Checked In At:</dt>
                            <dd class="col-sm-8">@(Model.CheckedInAt.HasValue? Model.CheckedInAt.Value.ToString("MMM dd, yyyy hh:mm tt") : "N/A")</dd>

                            @if (Model.RoomVisitId.HasValue)
                            {
                                <dt class="col-sm-4">Visit Record ID:</dt>
                                <dd class="col-sm-8">@Model.RoomVisitId</dd>
                            }
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- QR Code Display -->
        <div class="col-md-4">
            @if (!Model.IsCheckedIn && !string.IsNullOrEmpty(Model.QRCodeValue))
            {
                <div class="card">
                    <div class="card-header bg-success text-white text-center">
                        <h5><i class="fas fa-qr-code"></i> QR Code</h5>
                    </div>
                    <div class="card-body text-center">
                        <img src="data:image/png;base64,@ViewBag.QRCodeImage"
                             alt="QR Code"
                             class="img-fluid border p-2"
                             style="max-width: 250px;" />
                        <p class="text-muted mt-2 small">
                            <i class="fas fa-info-circle"></i> Scan this at the kiosk for quick check-in
                        </p>
                        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary mt-2">
                            <i class="fas fa-print"></i> Print QR Code
                        </button>
                    </div>
                </div>
            }
            else if (Model.IsCheckedIn)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> This visitor has already checked in.
                </div>
            }
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
            @if (!Model.IsCheckedIn)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
            }
        </div>
    </div>
</div>

<style>
    @@media print {
        .btn, nav, .card-header:not(.bg-success), .alert {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>
